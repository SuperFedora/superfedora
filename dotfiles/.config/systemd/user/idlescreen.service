# Managed by SuperFedora — 16-Bit IdleScreen Wayland Screensaver Daemon
[Unit]
Description=SuperFedora 16-Bit IdleScreen Wayland Screensaver Daemon
PartOf=graphical-session.target superfedora-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/usr/bin/sh -c 'for b in "$HOME/.local/bin/idlescreen" /usr/local/bin/idlescreen /usr/bin/idlescreen; do [ -x "$b" ] && exec "$b" daemon; done; exit 0'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=superfedora-session.target graphical-session.target
