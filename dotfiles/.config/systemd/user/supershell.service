# Managed by SuperFedora — Quickshell 16-Bit Wayland Shell & Dock Service
[Unit]
Description=SuperFedora Quickshell 16-Bit Wayland Shell & Dock
PartOf=graphical-session.target superfedora-session.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStartPre=/usr/bin/sh -c 'rm -f "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/superfedora.locked"'
ExecStart=/usr/bin/sh -c 'if pgrep -x quickshell >/dev/null || pgrep -x qs >/dev/null; then exec sleep infinity; fi; exec $(command -v quickshell || command -v qs || echo /usr/bin/quickshell)'
Restart=on-failure
RestartSec=1

[Install]
WantedBy=superfedora-session.target
