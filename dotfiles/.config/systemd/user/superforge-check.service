# Managed by SuperFedora — Weekly Native Binary & Toolchain Audit + Tier-2 Re-Forge
[Unit]
Description=SuperFedora Weekly Native Binary Audit & Background -march=native Re-Forge

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
ExecStart=/usr/bin/sh -c 'for b in "$HOME/.local/bin/superforge" /usr/local/bin/superforge; do [ -x "$b" ] && exec "$b" background-reforge; done'
