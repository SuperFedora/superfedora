[Desktop Entry]
Name=SuperNotify Studio
GenericName=Notification & Cast Comms Center
Comment=SuperFedora Notification History, Do Not Disturb & Cast Comms TUI
Exec=xdg-terminal-exec --class superfiles -e supernotify tui
Icon=preferences-desktop-notifications
