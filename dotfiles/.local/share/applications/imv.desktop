[Desktop Entry]
Type=Application
Name=imv
GenericName=Image Viewer
Comment=Wayland/X11 Image Viewer
Exec=imv-dir %F
Terminal=false
Icon=multimedia-photo-viewer
Categories=Graphics;2DGraphics;Viewer;
MimeType=image/bmp;image/gif;image/jpeg;image/jpg;image/pjpeg;image/png;image/tiff;image/x-bmp;image/x-pcx;image/x-png;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-tga;image/x-xbitmap;image/heif;image/heic;image/avif;image/webp;image/svg+xml;
StartupNotify=false
StartupWMClass=imv
