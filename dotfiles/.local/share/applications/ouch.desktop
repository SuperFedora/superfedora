[Desktop Entry]
Type=Application
Name=ouch Decompressor
GenericName=Archive Decompressor
Comment=Decompress archives with ouch
Exec=ouch decompress %F
Terminal=true
Icon=package-x-generic
Categories=Utility;Archiving;Compression;
MimeType=application/zip;application/x-compressed-tar;application/x-zstd-compressed-tar;application/x-7z-compressed;application/x-rar;
StartupNotify=false
