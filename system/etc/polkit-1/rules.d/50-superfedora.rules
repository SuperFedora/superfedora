// Managed by SuperFedora — Polkit rules for wheel users (Snapper, DNF5, systemd)

polkit.addRule(function(action, subject) {
    if (!subject.isInGroup("wheel") || !subject.local || !subject.active) {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.id.indexOf("org.opensuse.snapper.") === 0) {
        return polkit.Result.YES;
    }
    if (action.id === "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit") || "";
        if (unit === "superfedora-boot-guard.service" || unit.indexOf("btrfs-scrub@") === 0 || unit.indexOf("snapper-") === 0) {
            return polkit.Result.YES;
        }
        return polkit.Result.AUTH_ADMIN_KEEP;
    }
    if (action.id.indexOf("org.rpm.dnf.v0.") === 0) {
        return polkit.Result.AUTH_ADMIN_KEEP;
    }
    return polkit.Result.NOT_HANDLED;
});
